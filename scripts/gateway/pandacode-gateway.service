# The standalone gateway as a systemd service: one data directory, one writer, one
# port. See docs/gateway.md for the flags, the token and the reverse proxy.
#
# Install:
#   sudo install -m 0755 src-tauri/target/release/pandacode-gateway /usr/local/bin/
#   sudo install -d /var/lib/pandacode /srv/pandacode/dist
#   sudo install -m 0644 scripts/gateway/pandacode-gateway.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now pandacode-gateway
#   sudo cat /var/lib/pandacode/gateway-token     # paste into Settings → Remote gateway

[Unit]
Description=PandaCode gateway
Documentation=https://github.com/abacusbtc/pandacode/blob/master/docs/gateway.md
# The listener is loopback-only, so it needs no network to be up; whatever proxies
# to it retries on its own schedule. Do not add After=network-online.target here and
# start ordering an offline-capable service on DHCP.

[Service]
Type=simple
# Loopback only, so the generated token in the data directory is enough; a network
# bind would need --host and an explicit --token-file (docs/gateway.md).
ExecStart=/usr/local/bin/pandacode-gateway --data-dir /var/lib/pandacode --static-dir /srv/pandacode/dist --port 47399
Restart=always
# A restart loop that hammers the database is worse than a slow one.
RestartSec=2

# An ephemeral user, because the gateway needs no identity of its own: the token is
# what authorises, and the database is the only state. systemd hands the paths below
# to that user; on a systemd that does not, `StateDirectory=pandacode` creates and
# owns /var/lib/pandacode instead.
DynamicUser=yes
ReadWritePaths=/var/lib/pandacode

# The database and the token are the whole attack surface: nothing outside /var/lib
# is writable, and the process gains no privilege it did not start with.
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
# Deliberately absent: ProtectHome=yes. gateway_list_dirs is the point of the remote
# folder picker, and projects often live under a home directory; hiding /home would
# leave the picker listing an empty root. The process already runs unprivileged, so it
# reads what any other user can read and nothing more.

[Install]
WantedBy=multi-user.target
